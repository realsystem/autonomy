{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomy.local/spec/v0/audit-record.schema.json",
  "title": "Audit record",
  "description": "One link in a cell's tamper-evident audit chain. hash = sha256(prev_hash || canonical(record without hash and signature)); see spec/README.md#signatures-and-hashes. The first record of a chain has seq 0 and prev_hash sha256:000…0.",
  "type": "object",
  "required": ["seq", "prev_hash", "hash", "cell", "time", "actor", "kind", "correlationid", "refs", "summary", "signature"],
  "properties": {
    "seq": {"$ref": "common.schema.json#/$defs/safe_int"},
    "prev_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "cell": {"$ref": "common.schema.json#/$defs/cell"},
    "time": {"$ref": "common.schema.json#/$defs/timestamp"},
    "actor": {"$ref": "common.schema.json#/$defs/component_ref"},
    "kind": {"$ref": "common.schema.json#/$defs/event_type"},
    "correlationid": {"$ref": "common.schema.json#/$defs/correlationid"},
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$", "description": "W3C trace id of the action story (M9, IT-71). Optional."},
    "refs": {
      "type": "object",
      "properties": {
        "proposal": {"$ref": "common.schema.json#/$defs/proposal_id"},
        "evaluation": {"$ref": "common.schema.json#/$defs/evaluation_id"},
        "decision": {"$ref": "common.schema.json#/$defs/decision_id"},
        "approval": {"$ref": "common.schema.json#/$defs/approval_id"},
        "action": {"$ref": "common.schema.json#/$defs/action_id"},
        "verification": {"$ref": "common.schema.json#/$defs/verification_id"},
        "grant": {"$ref": "common.schema.json#/$defs/grant_id"},
        "job": {"$ref": "common.schema.json#/$defs/job_id"},
        "event": {"$ref": "common.schema.json#/$defs/ulid"}
      },
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "config_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "signature": {"$ref": "common.schema.json#/$defs/signature"}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomy.local/spec/v0/action-proposal.schema.json",
  "title": "ActionProposal",
  "description": "What an agent (or a job, or C06's MCP facade) wants done, with the evidence and the expected, verifiable effect. Agent → C13. Closed: it ends up inside an ActionRequest that C06 acts on.",
  "type": "object",
  "required": ["proposal_id", "proposer", "objective", "action", "rationale", "inputs", "expected_effect", "verification", "reversibility", "freshness_s", "idempotency_key"],
  "properties": {
    "proposal_id": {"$ref": "common.schema.json#/$defs/proposal_id"},
    "proposer": {"$ref": "common.schema.json#/$defs/component_ref"},
    "objective": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "pattern": "^obj_[A-Za-z0-9_-]{1,64}$"},
        "text": {"type": "string", "minLength": 1, "maxLength": 1000}
      },
      "additionalProperties": false
    },
    "action": {"$ref": "#/$defs/action"},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
    "inputs": {
      "description": "Evidence the proposal is based on. If any input is untrusted, the carrying envelope's trust must be untrusted.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "trust"],
        "properties": {
          "ref": {"$ref": "common.schema.json#/$defs/ref"},
          "trust": {"$ref": "common.schema.json#/$defs/trust"},
          "observed_at": {"$ref": "common.schema.json#/$defs/timestamp"}
        },
        "additionalProperties": false
      }
    },
    "expected_effect": {"$ref": "#/$defs/expected_effect"},
    "verification": {
      "type": "object",
      "required": ["probe", "independent"],
      "properties": {
        "probe": {"$ref": "common.schema.json#/$defs/dotted_name", "description": "How C14 checks the effect, e.g. ha.state."},
        "independent": {"type": "boolean", "description": "true when the probe does not read the same path the action wrote through."},
        "note": {"type": "string", "maxLength": 1000}
      },
      "additionalProperties": false
    },
    "reversibility": {
      "description": "Either an undo action (params may use the literal \"previous\" for the value before execution) or irreversible: true.",
      "type": "object",
      "properties": {
        "undo": {
          "type": "object",
          "required": ["type", "params"],
          "properties": {
            "type": {"$ref": "common.schema.json#/$defs/action_type"},
            "target": {"type": "string", "minLength": 1, "maxLength": 256},
            "params": {"type": "object"}
          },
          "additionalProperties": false
        },
        "irreversible": {"type": "boolean"},
        "note": {"type": "string", "maxLength": 1000}
      },
      "additionalProperties": false,
      "anyOf": [
        {"required": ["undo"]},
        {"required": ["irreversible"], "properties": {"irreversible": {"const": true}}}
      ],
      "not": {"required": ["undo", "irreversible"], "properties": {"irreversible": {"const": true}}}
    },
    "freshness_s": {"type": "integer", "minimum": 1, "description": "Maximum age of inputs, in seconds, for the proposal to still be valid."},
    "idempotency_key": {"$ref": "common.schema.json#/$defs/idempotency_key"}
  },
  "additionalProperties": false,
  "$defs": {
    "action": {
      "type": "object",
      "required": ["type", "target", "params"],
      "properties": {
        "type": {"$ref": "common.schema.json#/$defs/action_type"},
        "target": {"type": "string", "minLength": 1, "maxLength": 256, "description": "The resource acted on, e.g. an HA entity id."},
        "params": {"type": "object"}
      },
      "additionalProperties": false
    },
    "expected_effect": {
      "description": "kind is open: verifiers treat kinds they do not know as inconclusive. v0.1 defines state_equals and state_within.",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "within_s": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "state_equals"}}},
          "then": {"required": ["entity", "value", "within_s"], "properties": {"entity": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {"properties": {"kind": {"const": "state_within"}}},
          "then": {"required": ["entity", "min", "max", "within_s"], "properties": {"entity": {"type": "string", "minLength": 1}, "min": {"type": "number"}, "max": {"type": "number"}}}
        }
      ]
    }
  }
}

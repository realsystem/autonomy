{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomy.local/spec/v0/execution-record.schema.json",
  "title": "ExecutionRecord",
  "description": "C06's signed account of an ActionRequest. succeeded means the adapter accepted the call; it does not mean the outcome happened — only a Verification says that.",
  "type": "object",
  "required": ["action_id", "status", "executor", "signature"],
  "properties": {
    "action_id": {"$ref": "common.schema.json#/$defs/action_id"},
    "status": {"type": "string", "enum": ["accepted", "rejected", "started", "succeeded", "failed", "unknown", "cancelled"]},
    "adapter": {"$ref": "common.schema.json#/$defs/component_ref"},
    "started_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "finished_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "adapter_response": {"type": "object"},
    "before": {"description": "Resource state read before execution, when available."},
    "after_reported": {"description": "State the adapter reported after execution. Not verification."},
    "verification_pending": {"type": "boolean"},
    "error": {"$ref": "error.schema.json#/$defs/error_body"},
    "executor": {"$ref": "common.schema.json#/$defs/component_ref"},
    "signature": {"$ref": "common.schema.json#/$defs/signature"}
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["started", "succeeded", "failed", "unknown"]}}},
      "then": {"required": ["adapter", "started_at"]}
    },
    {
      "if": {"properties": {"status": {"enum": ["succeeded", "failed"]}}},
      "then": {"required": ["finished_at"]}
    },
    {
      "if": {"properties": {"status": {"enum": ["rejected", "failed"]}}},
      "then": {"required": ["error"]}
    }
  ]
}

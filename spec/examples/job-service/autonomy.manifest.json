{
  "$schema": "https://autonomy.local/spec/v0/manifest.schema.json",
  "component_id": "svc:job-service",
  "version": "2.0.0",
  "kind": "svc",
  "description": "Durable SQLite job queue with leases, retries and a dead-letter queue (processor, worker API v2).",
  "repository": "https://github.com/realsystem/processor",
  "contracts": {
    "envelope": "^0.1",
    "health": "^0.1",
    "error": "^0.1",
    "logging": "^0.1",
    "job": "^0.1"
  },
  "capabilities": {
    "provides": [
      {
        "name": "job.submit",
        "version": "2.0",
        "type": "api"
      },
      {
        "name": "job.lifecycle",
        "version": "1.0",
        "type": "event"
      }
    ]
  },
  "trust_class": "trusted-input",
  "data": {
    "owns": [
      {
        "store": "sqlite:/data/jobs.db",
        "kind": "job_queue",
        "retention_days": 90
      }
    ]
  },
  "runtime": {
    "packaging": [
      "binary",
      "docker"
    ],
    "health": {
      "liveness": "/v1/health",
      "readiness": "/v1/ready"
    },
    "resources": {
      "memory_mb": 128,
      "cpu": 0.5
    }
  },
  "dependencies": []
}
